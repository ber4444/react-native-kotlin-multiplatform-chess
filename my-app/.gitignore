.env*.local

# typescript
*.tsbuildinfo

example

# ── chess port ────────────────────────────────────────────────────────────────
# Generated from Kotlin multiplatform modules (Gradle js(IR) build output) — regenerate with npm run build:core.
src/generated/

# Generated from the single-source-of-truth piece drawables.
src/components/chess/piece-paths.generated.ts

# Generated split glbs (from assets/3d/chess.glb via scripts/split-chess-glb.js).
assets/3d/split/

# Web export
dist-web/

# ── Native projects ──────────────────────────────────────────────────────────
# Generated by `npx expo prebuild` (Continuous Native Generation) — never edit by
# hand. Native code lives in modules/ (local Expo modules) and native config in
# app.json, so both folders can be deleted and regenerated at any time.
/android
/ios

# Local Expo module build output
modules/*/android/build/
modules/*/android/.cxx/
